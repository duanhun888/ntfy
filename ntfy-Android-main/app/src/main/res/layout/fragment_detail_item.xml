<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:gravity="bottom">

    <TextView
        android:id="@+id/detail_item_avatar_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_chat_avatar_in"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:text="@string/chat_avatar_group"
        tools:ignore="HardcodedText" />

    <View
        android:id="@+id/detail_item_spacer_left"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/detail_item_bubble_column"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/detail_item_date_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginBottom="4dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/cn_ink_muted"
            android:textSize="11sp"
            tools:text="08:16" />

        <androidx.cardview.widget.CardView
            android:id="@+id/detail_item_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="true"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:id="@+id/detail_item_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/detail_item_priority_image"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_priority_5_24dp" />

                    <TextView
                        android:id="@+id/detail_item_new_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/ic_circle"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/detail_item_menu_button"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?android:attr/selectableItemBackground"
                        android:visibility="gone"
                        app:srcCompat="@drawable/ic_more_horiz_gray_24dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/detail_item_title_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:autoLink="web"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textStyle="bold"
                    tools:text="kafka预警" />

                <TextView
                    android:id="@+id/detail_item_message_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autoLink="web"
                    android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="disk almost full" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/detail_item_attachment_image"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:adjustViewBounds="true"
                    android:maxHeight="150dp"
                    android:maxWidth="220dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/roundedCornersImageView" />

                <TextView
                    android:id="@+id/detail_item_tags_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/TextAppearance.AppCompat.Small"
                    android:visibility="gone"
                    tools:text="Tags: ssh" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/detail_item_attachment_file_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/detail_item_attachment_file_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/detail_item_attachment_file_info"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:srcCompat="@drawable/ic_cancel_gray_24dp" />

                    <TextView
                        android:id="@+id/detail_item_attachment_file_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?android:attr/textColorPrimary"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/detail_item_attachment_file_icon"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="file.jpg" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/detail_item_actions_wrapper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:visibility="gone">

                    <androidx.constraintlayout.helper.widget.Flow
                        android:id="@+id/detail_item_actions_flow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:flow_horizontalAlign="start"
                        app:flow_horizontalBias="0"
                        app:flow_horizontalGap="0dp"
                        app:flow_horizontalStyle="packed"
                        app:flow_maxElementsWrap="3"
                        app:flow_verticalAlign="top"
                        app:flow_verticalGap="0dp"
                        app:flow_verticalStyle="packed"
                        app:flow_wrapMode="chain2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageView
                    android:id="@+id/detail_item_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="4dp"
                    android:adjustViewBounds="true"
                    android:scaleType="fitStart"
                    android:visibility="gone"
                    app:srcCompat="@drawable/ic_notification" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <View
        android:id="@+id/detail_item_spacer_right"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/detail_item_avatar_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_chat_avatar_out"
        android:gravity="center"
        android:text="@string/chat_avatar_me"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
