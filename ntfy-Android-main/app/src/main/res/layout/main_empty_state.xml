<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_empty_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:visibility="gone"
    tools:visibility="visible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="4dp">

            <View
                android:layout_width="36dp"
                android:layout_height="3dp"
                android:background="@drawable/bg_cn_accent_bar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/main_empty_brand"
                android:textColor="@color/cn_ink"
                android:textSize="26sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/main_no_subscriptions_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/main_no_subscriptions_text"
                android:textColor="@color/cn_ink_muted"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/main_empty_subtitle"
                android:textColor="@color/cn_ink_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="@string/main_empty_steps_header"
            android:textColor="@color/cn_ink_muted"
            android:textSize="12sp"
            android:letterSpacing="0.16" />

        <!-- Step 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_cn_panel"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cn_seal"
                android:gravity="center"
                android:text="1"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_empty_step1_title"
                    android:textColor="@color/cn_ink"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.04" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_empty_step1_body"
                    android:textColor="@color/cn_ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_cn_panel"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cn_seal"
                android:gravity="center"
                android:text="2"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_empty_step2_title"
                    android:textColor="@color/cn_ink"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.04" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_empty_step2_body"
                    android:textColor="@color/cn_ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 3 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_cn_panel"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cn_seal"
                android:gravity="center"
                android:text="3"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_empty_step3_title"
                    android:textColor="@color/cn_ink"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.04" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_empty_step3_body"
                    android:textColor="@color/cn_ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Step 4 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:padding="12dp"
            android:background="@drawable/bg_cn_panel"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_cn_seal"
                android:gravity="center"
                android:text="4"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="13sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/main_empty_step4_title"
                    android:textColor="@color/cn_ink"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:letterSpacing="0.04" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/main_empty_step4_body"
                    android:textColor="@color/cn_ink_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/main_empty_create_group"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/main_empty_create_group"
            android:textAllCaps="false"
            android:letterSpacing="0.06"
            app:backgroundTint="@color/cn_celadon"
            app:cornerRadius="2dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_cn_tip"
            android:padding="12dp">

            <View
                android:layout_width="3dp"
                android:layout_height="match_parent"
                android:minHeight="36dp"
                android:background="@color/cn_cinnabar" />

            <TextView
                android:id="@+id/main_how_to_link"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="@string/main_how_to_link"
                android:textColor="@color/cn_ink_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
